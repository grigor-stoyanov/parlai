PARLAI_SAMPLE_RATE=16000
PARLAI_BLOCK_SIZE=512
PARLAI_CHANNELS=1
PARLAI_RECORDINGS_DIR=recordings
# Optional: microphone as an index or name substring (see --mic-check for the list)
PARLAI_INPUT_DEVICE=
# Software volume multipliers, 1.0 = unchanged (try 2.0 if quiet; too high clips)
PARLAI_INPUT_GAIN=1.0
PARLAI_PLAYBACK_GAIN=1.0
# Speech recognition: any faster-whisper model name, and auto (GPU if it works), cuda or cpu
PARLAI_WHISPER_MODEL=small.en
PARLAI_WHISPER_DEVICE=auto
# Milliseconds of silence that end an utterance (lower = faster text, but splits sentences at pauses)
PARLAI_UTTERANCE_SILENCE_MS=500
