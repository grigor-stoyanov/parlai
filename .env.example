PARLAI_SAMPLE_RATE=16000
PARLAI_BLOCK_SIZE=512
PARLAI_CHANNELS=1
PARLAI_RECORDINGS_DIR=recordings
# Optional: microphone as an index or name substring (see --mic-check for the list)
PARLAI_INPUT_DEVICE=
# Software volume multipliers, 1.0 = unchanged (try 2.0 if quiet; too high clips)
PARLAI_INPUT_GAIN=1.0
PARLAI_PLAYBACK_GAIN=1.0
# Speech recognition: any faster-whisper model name, and auto (GPU if it works), cuda or cpu
PARLAI_WHISPER_MODEL=small.en
PARLAI_WHISPER_DEVICE=auto
# Milliseconds of silence that end an utterance (lower = faster text, but splits sentences at pauses)
PARLAI_UTTERANCE_SILENCE_MS=500
# Logging: folder for the daily files, DEBUG/INFO/WARNING/ERROR (DEBUG also logs recognised text), max total MB before the oldest files are deleted
PARLAI_LOG_DIR=logs
PARLAI_LOG_LEVEL=INFO
PARLAI_LOG_MAX_MB=50
# Days of logs to keep, and the lowest level shown in the terminal (DEBUG/INFO/WARNING/ERROR/OFF)
PARLAI_LOG_KEEP_DAYS=14
PARLAI_LOG_CONSOLE_LEVEL=WARNING
# Log file name (name.log, name-YYYY-MM-DD.log), format json or text, and noisy libraries to turn down to warnings (comma separated, or none)
PARLAI_LOG_NAME=parlai
PARLAI_LOG_FORMAT=json
PARLAI_LOG_QUIET_LOGGERS=httpx,httpcore,urllib3,huggingface_hub,filelock
